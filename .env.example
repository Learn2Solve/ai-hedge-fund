# LLM providers (set at least one)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GROQ_API_KEY=your-groq-api-key
GOOGLE_API_KEY=your-google-api-key
XAI_API_KEY=your-xai-api-key
DEEPSEEK_API_KEY=your-deepseek-api-key
GIGACHAT_API_KEY=your-gigachat-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
AZURE_OPENAI_API_KEY=your-azure-openai-api-key
AZURE_OPENAI_ENDPOINT=your-azure-openai-endpoint
AZURE_OPENAI_DEPLOYMENT_NAME=your-azure-openai-deployment-name

# Centralized exchange access
BINANCE_API_KEY=your-binance-api-key
BINANCE_API_SECRET=your-binance-api-secret
OKX_API_KEY=your-okx-api-key
OKX_API_SECRET=your-okx-api-secret
OKX_PASSPHRASE=your-okx-passphrase
HYPERLIQUID_API_KEY=your-hyperliquid-api-key
HYPERLIQUID_API_SECRET=your-hyperliquid-api-secret

# On-chain data providers
HELIUS_API_KEY=your-helius-api-key
TENDERLY_ACCESS_KEY=your-tenderly-access-key

# Replay and caching
REDIS_URL=redis://localhost:6379/0
DATA_CACHE_DIR=.cache/data

# LangGraph memory store
VECTOR_DB_PATH=.memory/vector

# Development toggles
LOG_LEVEL=INFO
DRY_RUN=true
